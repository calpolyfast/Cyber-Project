generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
}

model VulnerabilityGroup{
  id    Int @id @default(autoincrement())
  name  String
  vulnerabilities Vulnerability[]
}

model Vulnerability {
  id                    Int @id @default(autoincrement())
  name                  String
  description           String
  vulnerabilityGroupId  Int?
  vulnerabilityGroup    VulnerabilityGroup?  @relation(fields: [vulnerabilityGroupId], references: [id])
}

model Product {
  id      Int     @id @default(autoincrement())
  price   Decimal @db.Decimal(10, 2) 
  name    String
  visible Boolean @default(true)
}