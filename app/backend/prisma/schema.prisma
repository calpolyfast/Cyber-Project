generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
}

model VulnerabilityGroup{
  id    Int @id @default(autoincrement())
  name  String
  vulnerabilities Vulnerability[]
}

model Vulnerability {
  id                    Int @id @default(autoincrement())
  name                  String
  description           String
  vulnerabilityGroupId  Int?
  vulnerabilityGroup    VulnerabilityGroup?  @relation(fields: [vulnerabilityGroupId], references: [id])
}

model ImageField {
  id        Int     @id @default(autoincrement())
  url       String
  public_id String
  product   Product @relation(fields: [productId], references: [id])
  productId Int     @unique
}

model Product {
  id      Int       @id @default(autoincrement())
  name    String
  price   Decimal   @db.Decimal(10, 2)
  image   ImageField?
  visible Boolean   @default(true)
}
